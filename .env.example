; =====================================================================
; online_file 环境配置模板
; 部署到生产服务器时:cp .env.example .env 后按需修改(.env 已被 gitignore)
; 注意:
;   1. 值为字母数字可直接写;含空格/#/; 等字符的值必须加双引号("...")
;   2. APP_DEBUG 写 false 或 true(本项目约定 false=关闭调试)
;   3. 改 .env 后无需重启 php-fpm(每次请求重新读取)
; =====================================================================

; ---- 应用 ----
; 生产必须为 false(关闭调试页/错误详情);本地开发可留 true
APP_DEBUG = false

; JWT 签名密钥:生产务必改成随机值,生成命令: openssl rand -hex 32
; 该值一旦发布,旧登录令牌全部失效(所有用户需重新登录)
JWT_SECRET = 067f9685dd678d8ead54d3ab5a8c99d8ff059dd31ff9aa6cadcbb01a25ae4dc4

; ---- 数据库 ----
; 生产建议为 file 库建独立账号(不要用 root):
;   CREATE USER 'file'@'localhost' IDENTIFIED BY '强密码';
;   GRANT ALL PRIVILEGES ON `file`.* TO 'file'@'localhost'; FLUSH PRIVILEGES;
DB_HOST = 127.0.0.1
DB_PORT = 3306
DB_NAME = file
DB_USER = root
DB_PASS = root

; ---- 数据库调试(仅排查 SQL 用,平时不要开)----
DB_DEBUG = false
